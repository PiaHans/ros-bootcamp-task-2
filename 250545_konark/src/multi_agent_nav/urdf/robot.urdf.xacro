<?xml version="1.0"?>
<robot name="explore_bot" xmlns:xacro="http://ros.org/wiki/xacro">

  <!-- Argument passed from the launch file (e.g., robot1, robot2) -->
  <xacro:arg name="robot_name" default="robot1"/>
  <xacro:property name="prefix" value="$(arg robot_name)/" />

  <!-- Robot-specific chassis color -->
  <xacro:if value="${'$(arg robot_name)' == 'robot1'}">
    <xacro:property name="body_rgba" value="0.0 0.45 0.95 1.0" />  <!-- Vibrant Blue for Robot 1 -->
    <xacro:property name="gazebo_color" value="Gazebo/Blue" />
  </xacro:if>
  <xacro:unless value="${'$(arg robot_name)' == 'robot1'}">
    <xacro:property name="body_rgba" value="0.95 0.4 0.05 1.0" />  <!-- Vibrant Orange for Robot 2 -->
    <xacro:property name="gazebo_color" value="Gazebo/Orange" />
  </xacro:unless>

  <!-- ============================================== -->
  <!-- 1. BASE GEOMETRY & FRAMES                      -->
  <!-- ============================================== -->
  <link name="${prefix}base_footprint"/>

  <joint name="${prefix}base_joint" type="fixed">
    <parent link="${prefix}base_footprint"/>
    <child link="${prefix}base_link"/>
    <origin xyz="0 0 0.1" rpy="0 0 0"/>
  </joint>

  <link name="${prefix}base_link">
    <visual>
      <geometry><box size="0.4 0.3 0.15"/></geometry>
      <material name="${prefix}body_mat">
        <color rgba="${body_rgba}"/>
      </material>
    </visual>
    <collision>
      <geometry><box size="0.4 0.3 0.15"/></geometry>
    </collision>
    <inertial>
      <mass value="5.0"/>
      <inertia ixx="0.05" ixy="0.0" ixz="0.0" iyy="0.08" iyz="0.0" izz="0.1"/>
    </inertial>
  </link>

  <!-- ============================================== -->
  <!-- 2. WHEELS                                      -->
  <!-- ============================================== -->
  <!-- Left Wheel -->
  <link name="${prefix}left_wheel">
    <visual>
      <geometry><cylinder radius="0.1" length="0.05"/></geometry>
      <material name="${prefix}wheel_mat">
        <color rgba="0.15 0.15 0.15 1.0"/>
      </material>
    </visual>
    <collision><geometry><cylinder radius="0.1" length="0.05"/></geometry></collision>
    <inertial><mass value="0.5"/><inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.002"/></inertial>
  </link>
  <joint name="${prefix}left_wheel_joint" type="continuous">
    <parent link="${prefix}base_link"/>
    <child link="${prefix}left_wheel"/>
    <origin xyz="0 0.175 -0.05" rpy="-1.5707 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <!-- Right Wheel -->
  <link name="${prefix}right_wheel">
    <visual>
      <geometry><cylinder radius="0.1" length="0.05"/></geometry>
      <material name="${prefix}wheel_mat">
        <color rgba="0.15 0.15 0.15 1.0"/>
      </material>
    </visual>
    <collision><geometry><cylinder radius="0.1" length="0.05"/></geometry></collision>
    <inertial><mass value="0.5"/><inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.002"/></inertial>
  </link>
  <joint name="${prefix}right_wheel_joint" type="continuous">
    <parent link="${prefix}base_link"/>
    <child link="${prefix}right_wheel"/>
    <origin xyz="0 -0.175 -0.05" rpy="-1.5707 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <!-- Caster Wheel -->
  <link name="${prefix}caster_wheel">
    <visual>
      <geometry><sphere radius="0.05"/></geometry>
      <material name="${prefix}caster_mat">
        <color rgba="0.25 0.25 0.25 1.0"/>
      </material>
    </visual>
    <collision><geometry><sphere radius="0.05"/></geometry></collision>
    <inertial><mass value="0.1"/><inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/></inertial>
  </link>
  <joint name="${prefix}caster_joint" type="fixed">
    <parent link="${prefix}base_link"/>
    <child link="${prefix}caster_wheel"/>
    <origin xyz="0.15 0 -0.1" rpy="0 0 0"/>
  </joint>

  <!-- ============================================== -->
  <!-- 3. LIDAR SENSOR                                -->
  <!-- ============================================== -->
  <link name="${prefix}lidar_link">
    <visual>
      <geometry><cylinder radius="0.05" length="0.05"/></geometry>
      <material name="${prefix}lidar_mat">
        <color rgba="0.9 0.1 0.1 1.0"/>
      </material>
    </visual>
  </link>
  <joint name="${prefix}lidar_joint" type="fixed">
    <parent link="${prefix}base_link"/>
    <child link="${prefix}lidar_link"/>
    <origin xyz="0.15 0 0.1" rpy="0 0 0"/>
  </joint>

  <!-- ============================================== -->
  <!-- 4. GAZEBO PLUGINS (The critical multi-agent part)-->
  <!-- ============================================== -->
  <gazebo>
    <plugin name="$(arg robot_name)_diff_drive" filename="libgazebo_ros_diff_drive.so">
      <ros>
        <namespace>/$(arg robot_name)</namespace>
        <!-- Keep every robot's prefixed frames on the global TF graph. -->
        <remapping>tf:=/tf</remapping>
        <remapping>tf_static:=/tf_static</remapping>
      </ros>
      <update_rate>30</update_rate>
      <left_joint>${prefix}left_wheel_joint</left_joint>
      <right_joint>${prefix}right_wheel_joint</right_joint>
      <wheel_separation>0.35</wheel_separation>
      <wheel_diameter>0.2</wheel_diameter>
      
      <!-- TF Frames: This ensures odom and base_footprint belong to this specific bot -->
      <odometry_frame>${prefix}odom</odometry_frame>
      <robot_base_frame>${prefix}base_footprint</robot_base_frame>
      
      <publish_odom>true</publish_odom>
      <publish_odom_tf>true</publish_odom_tf>
      <publish_wheel_tf>false</publish_wheel_tf>
    </plugin>
  </gazebo>

  <gazebo>
    <plugin name="$(arg robot_name)_joint_state" filename="libgazebo_ros_joint_state_publisher.so">
      <ros>
        <namespace>/$(arg robot_name)</namespace>
      </ros>
      <update_rate>30</update_rate>
      <joint_name>${prefix}left_wheel_joint</joint_name>
      <joint_name>${prefix}right_wheel_joint</joint_name>
    </plugin>
  </gazebo>

  <gazebo reference="${prefix}lidar_link">
    <sensor type="ray" name="$(arg robot_name)_lidar_sensor">
      <pose>0 0 0 0 0 0</pose>
      <visualize>false</visualize>
      <update_rate>10</update_rate>
      <ray>
        <scan>
          <horizontal><samples>360</samples><resolution>1</resolution><min_angle>-3.14</min_angle><max_angle>3.14</max_angle></horizontal>
        </scan>
        <range><min>0.3</min><max>12.0</max></range>
      </ray>
      <plugin name="$(arg robot_name)_lidar_plugin" filename="libgazebo_ros_ray_sensor.so">
        <ros>
          <!-- Isolates the scan topic (e.g., /robot1/scan) -->
          <namespace>/$(arg robot_name)</namespace>
          <remapping>~/out:=scan</remapping>
        </ros>
        <output_type>sensor_msgs/LaserScan</output_type>
        <!-- Crucial: Tells the laser scan which bot's frame to attach to -->
        <frame_name>${prefix}lidar_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  <!-- Gazebo Material Colors -->
  <gazebo reference="${prefix}base_link">
    <material>${gazebo_color}</material>
  </gazebo>
  <gazebo reference="${prefix}left_wheel">
    <material>Gazebo/FlatBlack</material>
  </gazebo>
  <gazebo reference="${prefix}right_wheel">
    <material>Gazebo/FlatBlack</material>
  </gazebo>
  <gazebo reference="${prefix}caster_wheel">
    <material>Gazebo/FlatBlack</material>
  </gazebo>
  <gazebo reference="${prefix}lidar_link">
    <material>Gazebo/Red</material>
  </gazebo>

</robot>
